# Copy to .env. Every variable here is optional; the defaults below are what
# LLMConfig.from_env() uses when a variable is unset.

# --- Which backend ---------------------------------------------------------
# "claude_code" drives the Claude Code CLI and is the one that works with a
# University of Chicago Claude Enterprise seat - an Enterprise seat is NOT
# Anthropic API access.
#   claude_code (default) | anthropic | openrouter
LLM_PROVIDER=claude_code

# Model. Leave unset to use each provider's default (Opus 5). For bulk runs
# over thousands of rows, switch to Haiku - but note the slug spelling differs
# per provider, dashes vs dots:
#   claude_code -> haiku
#   anthropic   -> claude-haiku-4-5
#   openrouter  -> anthropic/claude-haiku-4.5
# LLM_MODEL=

# Reasoning depth: none | low | medium | high | xhigh | max
# The default is "low", to stay as close as possible to a plain LLM so that
# work done now still works after a switch to another provider.
# Caveat: on the claude_code backend this knob is weak. Measured on Opus 5
# (n=4 per level) the median thinking tokens were 190/150/255 for low/high/max
# - noise, not a trend. "none" is NOT available there at all. Do not rely on
# effort to remove reasoning; check LLMResponse.thinking_tokens instead.
# LLM_EFFORT=low

# --- Knobs -----------------------------------------------------------------
# Concurrency and limits for map_prompts / map_dataframe.
# LLM_MAX_WORKERS=4
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_S=180
# LLM_MAX_TOKENS=4096

# Name or path of the CLI executable, for the claude_code backend.
# CLAUDE_BIN=claude

# Directory the claude_code backend runs the CLI from. Defaults to
# .llm_scratch under the current working directory. Point this at a directory
# outside any project if you want the CLI to be unable to discover a CLAUDE.md
# by searching parent directories.
# LLM_SCRATCH_DIR=

# --- Credentials -----------------------------------------------------------
# Only needed to run the claude CLI where the browser login flow is not
# available, e.g. inside a container. Generate this on the HOST with:
#     claude setup-token
# It is a real credential, valid for one year. NEVER commit it. .env is
# gitignored, but notebook output cells can leak os.environ - do not commit
# notebook outputs either.
# CLAUDE_CODE_OAUTH_TOKEN=

# Only for LLM_PROVIDER=anthropic. Requires a console.anthropic.com account,
# which is separate from a Claude Enterprise seat.
# ANTHROPIC_API_KEY=

# Only for LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=

# --- Attribution (openrouter only) -----------------------------------------
# Sent as HTTP-Referer and X-Title so OpenRouter can attribute usage. Set
# these to your own project.
# LLM_HTTP_REFERER=https://github.com/your-org/your-project
# LLM_APP_TITLE=your-project
